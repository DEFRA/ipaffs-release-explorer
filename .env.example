# Copy to .env and replace the examples with your ADO project and pipeline IDs.
ADO_ORGANIZATION=https://dev.azure.com/example-org
ADO_PROJECT=example-project
ADO_DEV_PIPELINE_ID=101
ADO_CREATE_RELEASE_PIPELINE_ID=102
ADO_RELEASE_PIPELINE_ID=103
ADO_QA_PIPELINE_ID=104
ADO_RUNS_PER_PIPELINE=100
PORT=4317
ADO_CACHE_SECONDS=90
# Optional canonical DEV launch URLs. Set both; branch namespaces use recorded URLs.
# DEV_B2C_URL=https://frontend.example.invalid
# DEV_B2B_URL=https://internal-frontend.example.invalid
# The Helm chart supplies the service addresses for AKS.
# ALLOWED_HOSTS=localhost:4317,127.0.0.1:4317
# Local default authentication uses your existing Azure CLI session.
# AKS injects AZURE_TENANT_ID, AZURE_CLIENT_ID and AZURE_FEDERATED_TOKEN_FILE.
# For a local container, supply a read-only PAT at runtime; never commit it.
# ADO_PAT=
